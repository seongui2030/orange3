		<properties node_id="5" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x00\x81\x00\x00\x00\x91\x00\x00\x03\xae\x00\x00\x03\x07\x00\x00\x00\x81\x00\x00\x00\xb0\x00\x00\x03\xae\x00\x00\x03\x07\x00\x00\x00\x00\x00\x00\x00\x00\x07\x80\x00\x00\x00\x81\x00\x00\x00\xb0\x00\x00\x03\xae\x00\x00\x03\x07', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'import numpy as np\nfrom Orange.data import Table, Domain, ContinuousVariable, DiscreteVariable\n\ndomain = Domain([ContinuousVariable("age"),\n                 ContinuousVariable("height"),\n                 DiscreteVariable("gender", values=("M", "F"))])\narr = np.array([\n  [25, 186, 0],\n  [30, 164, 1]])\nout_data = Table.from_numpy(domain, arr)\n', 'filename': None}], 'scriptText': 'import numpy as np\nimport pandas as pd\nfrom Orange.data import ContinuousVariable, DiscreteVariable, Domain, Table\n\n# 1. k-Means에서 넘어온 입력 데이터(in_data) 확인\nif in_data is None:\n  raise ValueError(\n      "in_data가 비어 있습니다. k-Means 위젯 출력을 Python Script 입력에"\n      " 연결하세요."\n  )\n\ndf = pd.DataFrame(\n    in_data.X, columns=[var.name for var in in_data.domain.attributes]\n)\n\n# 2. Cluster 열 추출 (class_vars 또는 metas에서 탐색)\ncluster_var = None\nfor var in list(in_data.domain.class_vars) + list(in_data.domain.metas):\n  if "cluster" in var.name.lower():\n    cluster_var = var\n    break\n\nif cluster_var is None:\n  raise ValueError("Cluster 변수를 찾을 수 없습니다.")\n\nraw_vals = in_data.get_column(cluster_var)\nif isinstance(cluster_var, DiscreteVariable):\n  df["Cluster"] = [\n      cluster_var.values[int(v)] if not np.isnan(v) else "Unknown"\n      for v in raw_vals\n  ]\nelse:\n  df["Cluster"] = raw_vals\n\n# 3. 군집별 평균 중심점 계산\ncentroids = (\n    df.groupby("Cluster", as_index=False)[["latitude", "longitude"]].mean()\n)\ncentroids["Point_Type"] = "Centroid"\nprint(centroids.to_string(index=False))\n\n# 4. 다음 위젯(Concatenate / Scatter Plot)으로 보낼 Table 생성\nlat_var = ContinuousVariable("latitude")\nlon_var = ContinuousVariable("longitude")\ntype_var = DiscreteVariable("Point_Type", values=("Data", "Centroid"))\nout_cluster_var = DiscreteVariable(\n    "Cluster", values=tuple(sorted(centroids["Cluster"].unique()))\n)\n\nout_domain = Domain(\n    [lat_var, lon_var], class_vars=[out_cluster_var], metas=[type_var]\n)\nX_out = centroids[["latitude", "longitude"]].to_numpy()\nY_out = np.array(\n    [out_cluster_var.to_val(c) for c in centroids["Cluster"]], dtype=float\n).reshape(-1, 1)\nM_out = np.array(\n    [[type_var.to_val("Centroid")]] * len(centroids), dtype=object\n)\n\nout_data = Table(out_domain, X_out, Y_out, metas=M_out)', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\x98\x00\x00\x00V\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
